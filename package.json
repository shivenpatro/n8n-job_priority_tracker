{
  "name": "tech-job-market-monitor",
  "version": "1.0.0",
  "description": "Zero-server, scheduled automated analytics pipeline for tech job market & skill arbitrage monitor powered by headless n8n inside GitHub Actions",
  "main": "scripts/generate_pdf.js",
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.js",
