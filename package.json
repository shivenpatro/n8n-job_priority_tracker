    "pipeline:dry-run": "npx n8n execute --file workflows/job_monitor_pipeline.json"
  },
  "keywords": [
    "n8n",
    "automation",
    "job-market",
    "data-engineering",
    "github-actions",
    "puppeteer"
  ],
